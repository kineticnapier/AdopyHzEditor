    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>AdopyHzEditor.AssetExtractor</AssemblyName>
    <RootNamespace>AdopyHzEditor.AssetExtractor</RootNamespace>
